---
interface Props {
  title: string;
  downloadHref?: string;
  downloadLabel?: string;
}
const { title, downloadHref, downloadLabel = 'Download' } = Astro.props;
---

<section class="command-panel">
  <div class="command-panel__header">
    <p>{title}</p>
    {downloadHref && <a href={downloadHref} download>{downloadLabel}</a>}
  </div>
  <div class="command-panel__content"><slot /></div>
</section>
