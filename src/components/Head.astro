---
const { head } = Astro.locals.starlightRoute;
const headWithoutIcons = head.filter(
  ({ attrs }) => attrs?.rel !== 'icon' && attrs?.rel !== 'shortcut icon'
);
---

{headWithoutIcons.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/favicon.ico" />

<!-- Social Preview / OpenGraph -->
<meta property="og:image" content="https://docs.spike.tue.nl/og-image.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content="https://docs.spike.tue.nl/og-image.png" />

<!-- Force HTTPS upgrade for embedded assets -->
<meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
