---
interface Link {
  href: string;
  label: string;
}
interface Props {
  title?: string;
  links: Link[];
}
const { title = 'Next steps', links } = Astro.props;
---

<nav class="next-steps" aria-label={title}>
  <p>{title}</p>
  <ul>
    {links.map((link) => <li><a href={link.href}>{link.label} <span aria-hidden="true">→</span></a></li>)}
  </ul>
</nav>
